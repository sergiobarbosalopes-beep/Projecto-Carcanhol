{
  "name": "@carcanhol/copilot-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "build": "esbuild src/*.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:real": "npm run build && node scripts/real-smoke.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.14",
    "redis": "6.2.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
