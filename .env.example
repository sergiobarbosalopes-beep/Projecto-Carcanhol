# Public project URL. This value may be exposed by Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only credentials. Never prefix these variables with NEXT_PUBLIC_.
NEXT_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=carcanhol

# Server-only AES-256-GCM master key. Replace this marker with the canonical
# base64 output of 32 random bytes; never commit the generated value.
LLM_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
LLM_CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Server-only connection from the Next.js BFF to the isolated Copilot worker.
# Use the private service-binding URL when the hosting platform provides one.
# Plain HTTP is accepted only for localhost outside production.
COPILOT_WORKER_URL=https://copilot-worker.internal.example
COPILOT_WORKER_HMAC_SECRET=replace-with-base64-32-to-64-byte-secret
COPILOT_WORKER_TIMEOUT_MS=30000

# Worker-only settings. Configure these only in the isolated worker service,
# together with COPILOT_WORKER_HMAC_SECRET. Do not give that service Supabase
# keys or LLM_CREDENTIAL_ENCRYPTION_KEY.
COPILOT_VALIDATION_TIMEOUT_MS=15000
COPILOT_INFERENCE_TIMEOUT_MS=20000
COPILOT_WORKER_CLOCK_SKEW_MS=30000
COPILOT_WORKER_MAX_CONCURRENCY=2
COPILOT_WORKER_MAX_QUEUE=8
COPILOT_REPLAY_REDIS_URL=rediss://user:password@redis.example:6380
COPILOT_REPLAY_REDIS_PREFIX=carcanhol:copilot-replay:
COPILOT_REPLAY_STORE_TIMEOUT_MS=1000

# Provider credentials, including GitHub Copilot fine-grained PATs, are entered
# in Administração > LLM and encrypted server-side. Never add them here or to
# a NEXT_PUBLIC_ variable.
