# Public project URL. This value may be exposed by Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only credentials. Never prefix these variables with NEXT_PUBLIC_.
NEXT_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=carcanhol

# Server-only AES-256-GCM master key. Replace this marker with the canonical
# base64 output of 32 random bytes; never commit the generated value.
LLM_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
LLM_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
